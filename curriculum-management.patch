+
+export const addSubject = (c: Curriculum, semesterId: string, subject: SubjectDef) => checked(mapSemester(c, semesterId, s => ({ ...s, subjects: [...s.subjects, { ...subject, id: subject.id.trim().toUpperCase() }] })));
