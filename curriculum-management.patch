+
+// ---- suggestions -----------------------------------------------------------------------------
+export function suggestCode(name: string, taken: string[], max: number, min = 2): string {
+  const words = name.toUpperCase().replace(/[^A-Z0-9 ]/g, ' ').split(' ').filter(w => w && !['OF', 'AND', 'THE', 'TO', 'IN', 'FOR'].includes(w));
