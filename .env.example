# Required to enable admin editing. Choose a long unique password (12+ characters).
ADMIN_PASSWORD=
# Required on Vercel. Leave BOTH blank to use SQLite locally.
SUPABASE_URL=
# Backend secret key (sb_secret_...), NOT the publishable / anon key.
SUPABASE_SECRET_KEY=
# Optional free-tier Groq AI. Leave the key empty to use local formatting.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b
# Local SQLite only. Do not set this on Vercel.
DATABASE_PATH=
